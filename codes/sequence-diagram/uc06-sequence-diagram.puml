@startuml uc06-sequence-diagram

autonumber

title UC06 — Gerenciar Inscrição no Evento

skinparam backgroundColor #FAFFFE

skinparam sequence {
    ArrowColor #1B5E20
    ArrowFontColor #33691E
    LifeLineBorderColor #558B2F
    LifeLineBackgroundColor #F1F8E9
    ParticipantBorderColor #2E7D32
    ParticipantBackgroundColor #E8F5E9
    ParticipantFontStyle bold
    ActorBorderColor #2E7D32
    ActorBackgroundColor #E8F5E9
    GroupBorderColor #558B2F
    GroupHeaderFontColor #1B5E20
    GroupBackgroundColor #F9FBE7
    BoxBorderColor #558B2F
    BoxBackgroundColor #F9FBE7
    DividerBorderColor #2E7D32
    DividerBackgroundColor #C8E6C9
    DividerFontColor #1B5E20
}

skinparam note {
    BackgroundColor #FFFDE7
    BorderColor #F9A825
}

skinparam database {
    BackgroundColor #E8EAF6
    BorderColor #283593
}

skinparam queue {
    BackgroundColor #FFF8E1
    BorderColor #E65100
}

actor "Participante" as Part
actor "Organizador" as Org

participant "Frontend" as Tela
participant "API Gateway" as APIGW
participant "ControleInscricao" as CI
participant "ControleEvento" as CE
participant "ControleUsuario" as CU

database "PostgreSQL\nEventos" as DBEventos
database "PostgreSQL\nUsuarios" as DBUsuarios

queue "Fila de\nNotificações" as QNotif

participant "Worker\nNotificações" as WN
participant "Serviço de Email" as SE

== Criação de Inscrição ==

Part -> Tela : solicitarInscricao(eventoID)
activate Tela

Tela -> APIGW : solicitarInscricao(eventoID)
activate APIGW

APIGW -> CI : inscrever(eventoID, participanteID)
activate CI

CI -> CU : verificarParticipante(participanteID)
activate CU
CU -> DBUsuarios : findById(participanteID)
activate DBUsuarios
DBUsuarios --> CU : participanteEncontrado()
deactivate DBUsuarios
CU --> CI : participanteAtivo()
deactivate CU

CI -> CE : verificarDisponibilidadeEvento(eventoID)
activate CE
CE -> DBEventos : findEventoById(eventoID)
activate DBEventos
DBEventos --> CE : eventoEncontrado(limiteParticipantes, totalInscritos)
deactivate DBEventos
CE --> CI : eventoDisponivel(vagasRestantes)
deactivate CE

CI -> DBEventos : existeInscricaoAtiva(eventoID, participanteID)
activate DBEventos
DBEventos --> CI : inscricaoInexistente()
deactivate DBEventos

alt Evento disponível e participante elegível

    CI -> DBEventos : salvarInscricao(eventoID, participanteID, data, status=PENDENTE)
    activate DBEventos
    DBEventos --> CI : inscricaoCriada(inscricaoID)
    deactivate DBEventos

    CI -> DBEventos : salvarIngresso(inscricaoID, codigo, dataEmissao, status=VALIDO)
    activate DBEventos
    DBEventos --> CI : ingressoCriado(ingressoID, codigoIngresso)
    deactivate DBEventos

    note right of CI
        Inscrição criada com status PENDENTE.
        Aguarda confirmação do pagamento (UC07).
        Ingresso gerado com código único (UUID).
    end note

    CI -> QNotif : publicarNotificacao(INSCRICAO_CRIADA, participanteID, eventoID, ingressoID)
    activate QNotif
    QNotif --> CI : mensagemPublicada()
    deactivate QNotif

    CI --> APIGW : inscricaoCriada(inscricaoID, codigoIngresso, valorIngresso)
    APIGW --> Tela : inscricaoCriada(dadosInscricao)
    Tela --> Part : exibirResumoInscricao(inscricaoID, codigoIngresso, valor)

else Evento sem vagas disponíveis

    CI --> APIGW : eventoLotado()
    APIGW --> Tela : eventoLotado()
    Tela --> Part : exibirErro("Evento esgotado, sem vagas disponíveis")

else Participante já inscrito neste evento

    CI --> APIGW : inscricaoDuplicada()
    APIGW --> Tela : inscricaoDuplicada()
    Tela --> Part : exibirErro("Você já possui uma inscrição ativa neste evento")

end

deactivate CI
deactivate APIGW
deactivate Tela

== Processamento Assíncrono — Notificação de Inscrição ==

group Fluxo Assíncrono

    QNotif -> WN : consumirMensagem()
    activate WN
    WN -> SE : enviarEmailsInscricaoCriada(participanteEmail, organizadorEmail,\ndadosEvento, codigoIngresso)
    activate SE
    SE ->> Part : emailConfirmacaoInscricao()
    SE ->> Org : emailNovaInscricaoRecebida()
    SE --> WN : emailsEnviados()
    deactivate SE
    deactivate WN

end

== Cancelamento de Inscrição ==

Part -> Tela : cancelarInscricao(inscricaoID)
activate Tela

Tela -> APIGW : cancelarInscricao(inscricaoID)
activate APIGW

APIGW -> CI : cancelarInscricao(inscricaoID, participanteID)
activate CI

CI -> DBEventos : findInscricaoById(inscricaoID)
activate DBEventos
DBEventos --> CI : inscricaoEncontrada(status, ingressoID, eventoID)
deactivate DBEventos

opt Inscrição com status CONFIRMADA (pagamento já realizado)

    note right of CI
        Cancelamento de inscrição confirmada
        requer solicitação de reembolso (UC08).
        Apenas inscrições PENDENTE são canceláveis aqui.
    end note

end

CI -> DBEventos : atualizarInscricao(inscricaoID, status=CANCELADA)
activate DBEventos
DBEventos --> CI : inscricaoAtualizada()
deactivate DBEventos

CI -> DBEventos : atualizarIngresso(ingressoID, status=CANCELADO)
activate DBEventos
DBEventos --> CI : ingressoAtualizado()
deactivate DBEventos

CI -> QNotif : publicarNotificacao(INSCRICAO_CANCELADA, participanteID, eventoID, inscricaoID)
activate QNotif
QNotif --> CI : mensagemPublicada()
deactivate QNotif

CI --> APIGW : cancelamentoConcluido()
APIGW --> Tela : cancelamentoConcluido()
Tela --> Part : exibirConfirmacaoCancelamento()

deactivate CI
deactivate APIGW
deactivate Tela

group Fluxo Assíncrono — Notificação de Cancelamento

    QNotif -> WN : consumirMensagem()
    activate WN
    WN -> SE : enviarEmailCancelamento(participanteEmail, organizadorEmail, dadosEvento)
    activate SE
    SE ->> Part : emailCancelamentoInscricao()
    SE ->> Org : emailInscricaoCancelada()
    SE --> WN : emailsEnviados()
    deactivate SE
    deactivate WN

end

@enduml
