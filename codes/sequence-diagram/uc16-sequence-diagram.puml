@startuml uc16-sequence-diagram

autonumber

title UC16 - Gerenciar Eventos

skinparam backgroundColor #FAFFFE

skinparam sequence {
    ArrowColor #1B5E20
    ArrowFontColor #33691E
    LifeLineBorderColor #558B2F
    LifeLineBackgroundColor #F1F8E9
    ParticipantBorderColor #2E7D32
    ParticipantBackgroundColor #E8F5E9
    ParticipantFontStyle bold
    ActorBorderColor #2E7D32
    ActorBackgroundColor #E8F5E9
    GroupBorderColor #558B2F
    GroupHeaderFontColor #1B5E20
    GroupBackgroundColor #F9FBE7
    BoxBorderColor #558B2F
    BoxBackgroundColor #F9FBE7
    DividerBorderColor #2E7D32
    DividerBackgroundColor #C8E6C9
    DividerFontColor #1B5E20
}

skinparam database {
    BackgroundColor #E8EAF6
    BorderColor #283593
}

skinparam queue {
    BackgroundColor #FFF8E1
    BorderColor #E65100
}

actor "Organizador" as Org
actor "Participante" as Part

participant "Frontend" as Tela
participant "API Gateway" as APIGW
participant "ControleEvento" as CE
participant "ControleOrganizador" as CO
participant "ControleLocal" as CL
participant "ControleCategoria" as CC

database "PostgreSQL\nEventos" as DBEventos
database "PostgreSQL\nUsuários" as DBUsuarios

queue "Fila de\nNotificações" as QNotif

participant "Worker\nNotificações" as WN
participant "Serviço de Email" as SE

== Criação de Evento ==

Org -> Tela : acessarFormularioCriacaoEvento()
activate Tela

Tela -> APIGW : listarCategorias()
activate APIGW
APIGW -> CC : listarCategorias()
activate CC
CC -> DBEventos : findAllCategorias()
activate DBEventos
DBEventos --> CC : categoriasEncontradas(listaCategorias)
deactivate DBEventos
CC --> APIGW : categorias(listaCategorias)
deactivate CC
APIGW --> Tela : categorias(listaCategorias)
deactivate APIGW

Tela -> APIGW : listarLocais(organizadorID)
activate APIGW
APIGW -> CL : listarLocaisDoOrganizador(organizadorID)
activate CL
CL -> DBEventos : findLocaisByOrganizador(organizadorID)
activate DBEventos
DBEventos --> CL : locaisEncontrados(listaLocais)
deactivate DBEventos
CL --> APIGW : locais(listaLocais)
deactivate CL
APIGW --> Tela : locais(listaLocais)
deactivate APIGW

Tela --> Org : exibirFormularioCriacao(categorias, locais)

Org -> Tela : submeterEvento(titulo, descricao, dataInicio, dataFim,\nlocalID, categoriaID, limiteParticipantes, imagem)

Tela -> APIGW : criarEvento(dadosEvento)
activate APIGW

APIGW -> CE : criarEvento(dadosEvento, organizadorID)
activate CE

CE -> CO : verificarOrganizadorAtivo(organizadorID)
activate CO
CO -> DBUsuarios : findOrganizadorById(organizadorID)
activate DBUsuarios
DBUsuarios --> CO : organizadorEncontrado(status=ATIVO)
deactivate DBUsuarios
CO --> CE : organizadorAutorizado()
deactivate CO

CE -> CL : verificarDisponibilidadeLocal(localID, dataInicio, dataFim)
activate CL
CL -> DBEventos : findConflitosDeAgenda(localID, dataInicio, dataFim)
activate DBEventos
DBEventos --> CL : semConflitosEncontrados()
deactivate DBEventos
CL --> CE : localDisponivel()
deactivate CL

CE -> DBEventos : findCategoriaById(categoriaID)
activate DBEventos
DBEventos --> CE : categoriaEncontrada(nome, descricao)
deactivate DBEventos

alt Dados válidos e local disponível

    CE -> DBEventos : salvarEvento(titulo, descricao, dataInicio, dataFim,\nlocalID, categoriaID, organizadorID, status=RASCUNHO)
    activate DBEventos
    DBEventos --> CE : eventoCriado(eventoID)
    deactivate DBEventos

    CE --> APIGW : eventoCriado(eventoID, status=RASCUNHO)
    APIGW --> Tela : eventoCriado(eventoID)
    Tela --> Org : exibirEventoCriado(eventoID, status=RASCUNHO)

else Local indisponível no período solicitado

    CE --> APIGW : localIndisponivel()
    APIGW --> Tela : localIndisponivel()
    Tela --> Org : exibirErro("Local indisponível para o período informado")

end

deactivate CE
deactivate APIGW
deactivate Tela

== Edição de Evento ==

Org -> Tela : editarEvento(eventoID, dadosAtualizados)
activate Tela

Tela -> APIGW : editarEvento(eventoID, dadosAtualizados)
activate APIGW

APIGW -> CE : atualizarEvento(eventoID, organizadorID, dadosAtualizados)
activate CE

CE -> DBEventos : findEventoById(eventoID)
activate DBEventos
DBEventos --> CE : eventoEncontrado(status=RASCUNHO, organizadorID)
deactivate DBEventos

CE -> DBEventos : atualizarEvento(eventoID, dadosAtualizados)
activate DBEventos
DBEventos --> CE : eventoAtualizado()
deactivate DBEventos

CE --> APIGW : eventoAtualizado(eventoID)
APIGW --> Tela : eventoAtualizado(eventoID)
Tela --> Org : exibirEventoAtualizado()

deactivate CE
deactivate APIGW
deactivate Tela

== Publicação de Evento ==

Org -> Tela : publicarEvento(eventoID)
activate Tela

Tela -> APIGW : publicarEvento(eventoID)
activate APIGW

APIGW -> CE : publicarEvento(eventoID, organizadorID)
activate CE

CE -> DBEventos : findEventoById(eventoID)
activate DBEventos
DBEventos --> CE : eventoEncontrado(status=RASCUNHO, localID, dataInicio, dataFim)
deactivate DBEventos

CE -> CL : reconfirmarDisponibilidade(localID, dataInicio, dataFim)
activate CL
CL -> DBEventos : findConflitosDeAgenda(localID, dataInicio, dataFim)
activate DBEventos
DBEventos --> CL : semConflitosEncontrados()
deactivate DBEventos
CL --> CE : localConfirmado()
deactivate CL

CE -> DBEventos : atualizarEvento(eventoID, status=PUBLICADO, dataPublicacao)
activate DBEventos
DBEventos --> CE : eventoAtualizado()
deactivate DBEventos

CE -> DBEventos : findFavoritosDoEvento(eventoID)
activate DBEventos
DBEventos --> CE : favoritosEncontrados(participantesInteressados)
deactivate DBEventos

CE ->> QNotif : publicarNotificacao(EVENTO_PUBLICADO, eventoID, titulo, participantesInteressados)
activate QNotif
QNotif --> CE : mensagemPublicada()
deactivate QNotif

CE --> APIGW : eventoPublicado(eventoID, urlEvento)
APIGW --> Tela : eventoPublicado(urlEvento)
Tela --> Org : exibirEventoPublicado(urlEvento, linkInscricao)

deactivate CE
deactivate APIGW
deactivate Tela

QNotif ->> WN : consumirMensagem()
activate WN
WN ->> SE : notificarParticipantesInteressados(listaEmails, dadosEvento)
deactivate WN
activate SE
SE ->> Part : emailEventoPublicado()
deactivate SE

== Cancelamento de Evento ==

Org -> Tela : cancelarEvento(eventoID, motivo)
activate Tela

Tela -> APIGW : cancelarEvento(eventoID, motivo)
activate APIGW

APIGW -> CE : cancelarEvento(eventoID, organizadorID, motivo)
activate CE

CE -> DBEventos : findEventoById(eventoID)
activate DBEventos
DBEventos --> CE : eventoEncontrado(status=PUBLICADO)
deactivate DBEventos

CE -> DBEventos : findInscricoesAtivas(eventoID)
activate DBEventos
DBEventos --> CE : inscricoesEncontradas(confirmadas, pendentes, totalInscritos)
deactivate DBEventos

loop Para cada inscrição ativa
    CE -> DBEventos : atualizarInscricao(inscricaoID, status=CANCELADA)
    activate DBEventos
    DBEventos --> CE : inscricaoAtualizada()
    deactivate DBEventos

    CE -> DBEventos : atualizarIngresso(ingressoID, status=CANCELADO)
    activate DBEventos
    DBEventos --> CE : ingressoAtualizado()
    deactivate DBEventos
end

CE -> DBEventos : atualizarEvento(eventoID, status=CANCELADO)
activate DBEventos
DBEventos --> CE : eventoAtualizado()
deactivate DBEventos

CE ->> QNotif : publicarNotificacao(EVENTO_CANCELADO, eventoID, motivo, qtdInscritos)
activate QNotif
QNotif --> CE : mensagemPublicada()
deactivate QNotif

CE --> APIGW : eventoCancelado(eventoID, qtdInscritos)
APIGW --> Tela : eventoCancelado(eventoID)
Tela --> Org : exibirEventoCancelado(qtdInscritos, mensagemReembolsos)

deactivate CE
deactivate APIGW
deactivate Tela

QNotif ->> WN : consumirMensagem()
activate WN
WN ->> SE : notificarParticipantesEventoCancelado(listaEmails, motivo, dadosEvento)
deactivate WN
activate SE
SE ->> Part : emailEventoCancelado(motivo)
deactivate SE

@enduml
