@startuml uc16-sequence-diagram

autonumber

title UC16 — Gerenciar Eventos

skinparam backgroundColor #FAFFFE

skinparam sequence {
    ArrowColor #1B5E20
    ArrowFontColor #33691E
    LifeLineBorderColor #558B2F
    LifeLineBackgroundColor #F1F8E9
    ParticipantBorderColor #2E7D32
    ParticipantBackgroundColor #E8F5E9
    ParticipantFontStyle bold
    ActorBorderColor #2E7D32
    ActorBackgroundColor #E8F5E9
    GroupBorderColor #558B2F
    GroupHeaderFontColor #1B5E20
    GroupBackgroundColor #F9FBE7
    BoxBorderColor #558B2F
    BoxBackgroundColor #F9FBE7
    DividerBorderColor #2E7D32
    DividerBackgroundColor #C8E6C9
    DividerFontColor #1B5E20
}

skinparam note {
    BackgroundColor #FFFDE7
    BorderColor #F9A825
}

skinparam database {
    BackgroundColor #E8EAF6
    BorderColor #283593
}

skinparam queue {
    BackgroundColor #FFF8E1
    BorderColor #E65100
}

actor "Organizador" as Org

participant "Frontend\n<<Next.js>>" as Tela
participant "API Gateway\n<<AWS>>" as APIGW
participant "ControleEvento\n<<Eventos Service>>" as CE
participant "ControleOrganizador\n<<Usuarios Service>>" as CO
participant "ControleLocal\n<<Eventos Service>>" as CL
participant "ControleCategoria\n<<Eventos Service>>" as CC

database "PostgreSQL\nEventos" as DBEventos
database "PostgreSQL\nUsuarios" as DBUsuarios

queue "Fila de\nNotificações\n<<RabbitMQ>>" as QNotif

participant "Worker\nNotificações" as WN
participant "Serviço de Email\n<<Comunicacao Service>>" as SE

== Criação de Evento ==

Org -> Tela : acessarFormularioCriacaoEvento()
activate Tela

Tela -> APIGW : GET /categorias
activate APIGW
APIGW -> CC : listarCategorias()
activate CC
CC -> DBEventos : findAllCategorias()
activate DBEventos
DBEventos --> CC : List<Categoria>
deactivate DBEventos
CC --> APIGW : categorias
deactivate CC
APIGW --> Tela : 200 OK (categorias)
deactivate APIGW

Tela -> APIGW : GET /locais?organizadorID={organizadorID}
activate APIGW
APIGW -> CL : listarLocaisDoOrganizador(organizadorID)
activate CL
CL -> DBEventos : findLocaisByOrganizador(organizadorID)
activate DBEventos
DBEventos --> CL : List<Local>
deactivate DBEventos
CL --> APIGW : locais
deactivate CL
APIGW --> Tela : 200 OK (locais)
deactivate APIGW

Tela --> Org : exibirFormularioCriacao(categorias, locais)

Org -> Tela : submeterEvento(titulo, descricao, dataInicio, dataFim,\nlocalID, categoriaID, limiteParticipantes, imagem)

Tela -> APIGW : POST /eventos\n[Authorization: Bearer {token}]
activate APIGW

APIGW -> CE : criarEvento(dadosEvento, organizadorID)
activate CE

CE -> CO : verificarOrganizadorAtivo(organizadorID)
activate CO
CO -> DBUsuarios : findOrganizadorById(organizadorID)
activate DBUsuarios
DBUsuarios --> CO : Organizador{status=ATIVO}
deactivate DBUsuarios
CO --> CE : organizadorAutorizado()
deactivate CO

CE -> CL : verificarDisponibilidadeLocal(localID, dataInicio, dataFim)
activate CL
CL -> DBEventos : findConflitosDeAgenda(localID, dataInicio, dataFim)
activate DBEventos
DBEventos --> CL : List<Conflito> (vazio)
deactivate DBEventos
CL --> CE : localDisponivel()
deactivate CL

CE -> DBEventos : findCategoriaById(categoriaID)
activate DBEventos
DBEventos --> CE : Categoria{nome, descricao}
deactivate DBEventos

alt Evento criado com sucesso [dados válidos AND local disponível]

    CE -> DBEventos : save(Evento{titulo, descricao, dataInicio, dataFim,\nlocalID, categoriaID, organizadorID,\nlimiteParticipantes, imagem, status=RASCUNHO})
    activate DBEventos
    DBEventos --> CE : eventoID
    deactivate DBEventos

    note right of CE
        Evento salvo com status RASCUNHO.
        O organizador pode editar livremente
        antes de publicar para os participantes.
    end note

    CE --> APIGW : EventoDTO{eventoID, titulo, status=RASCUNHO}
    APIGW --> Tela : 201 Created
    deactivate APIGW
    Tela --> Org : exibirEventoCriado(eventoID, status=RASCUNHO)

else Local indisponível no período solicitado

    CE --> APIGW : LocalIndisponivelException{localID, conflitos}
    APIGW --> Tela : 409 Conflict
    deactivate APIGW
    Tela --> Org : exibirErro("Local indisponível para o período informado")

end

deactivate CE
deactivate Tela

== Edição de Evento ==

Org -> Tela : editarEvento(eventoID, dadosAtualizados)
activate Tela

Tela -> APIGW : PUT /eventos/{eventoID}\n[Authorization: Bearer {token}]
activate APIGW

APIGW -> CE : atualizarEvento(eventoID, organizadorID, dadosAtualizados)
activate CE

CE -> DBEventos : findEventoById(eventoID)
activate DBEventos
DBEventos --> CE : Evento{status=RASCUNHO, organizadorID}
deactivate DBEventos

CE -> DBEventos : update(Evento{eventoID, dadosAtualizados})
activate DBEventos
DBEventos --> CE : updated()
deactivate DBEventos

CE --> APIGW : EventoDTO{eventoID, status=RASCUNHO, dadosAtualizados}
APIGW --> Tela : 200 OK
deactivate APIGW
Tela --> Org : exibirEventoAtualizado()

deactivate CE
deactivate Tela

== Publicação de Evento ==

Org -> Tela : publicarEvento(eventoID)
activate Tela

Tela -> APIGW : PATCH /eventos/{eventoID}/publicar\n[Authorization: Bearer {token}]
activate APIGW

APIGW -> CE : publicarEvento(eventoID, organizadorID)
activate CE

CE -> DBEventos : findEventoById(eventoID)
activate DBEventos
DBEventos --> CE : Evento{status=RASCUNHO, localID, dataInicio, dataFim}
deactivate DBEventos

CE -> CL : reconfirmarDisponibilidade(localID, dataInicio, dataFim)
activate CL
CL -> DBEventos : findConflitosDeAgenda(localID, dataInicio, dataFim)
activate DBEventos
DBEventos --> CL : List<Conflito> (vazio)
deactivate DBEventos
CL --> CE : localConfirmado()
deactivate CL

CE -> DBEventos : update(Evento{eventoID, status=PUBLICADO, dataPublicacao=now()})
activate DBEventos
DBEventos --> CE : updated()
deactivate DBEventos

CE -> DBEventos : findFavoritosDoEvento(eventoID)
activate DBEventos
DBEventos --> CE : List<Favorito>{participantesInteressados}
deactivate DBEventos

CE -> QNotif : publish({tipo: EVENTO_PUBLICADO,\neventoID, titulo, dataInicio, participantesInteressados})
activate QNotif
QNotif --> CE : ack()
deactivate QNotif

CE --> APIGW : EventoDTO{eventoID, status=PUBLICADO}
APIGW --> Tela : 200 OK
deactivate APIGW
Tela --> Org : exibirEventoPublicado(urlEvento, linkInscricao)

deactivate CE
deactivate Tela

group Fluxo Assíncrono — Notificação de Publicação

    QNotif -> WN : consumir(EVENTO_PUBLICADO)
    activate WN
    WN -> SE : notificarParticipantesInteressados(listaEmails, dadosEvento)
    activate SE
    SE --> WN : emailsDisparados(qtd)
    deactivate SE
    deactivate WN

end

== Cancelamento de Evento ==

Org -> Tela : cancelarEvento(eventoID, motivo)
activate Tela

Tela -> APIGW : PATCH /eventos/{eventoID}/cancelar\n[Authorization: Bearer {token}]\n(motivo)
activate APIGW

APIGW -> CE : cancelarEvento(eventoID, organizadorID, motivo)
activate CE

CE -> DBEventos : findEventoById(eventoID)
activate DBEventos
DBEventos --> CE : Evento{status=PUBLICADO}
deactivate DBEventos

CE -> DBEventos : findInscricoesAtivas(eventoID)
activate DBEventos
DBEventos --> CE : List<Inscricao>{confirmadas, pendentes, totalInscritos}
deactivate DBEventos

loop Para cada inscrição ativa

    CE -> DBEventos : update(Inscricao{inscricaoID, status=CANCELADA})
    activate DBEventos
    DBEventos --> CE : updated()
    deactivate DBEventos

end

CE -> DBEventos : update(Evento{eventoID, status=CANCELADO})
activate DBEventos
DBEventos --> CE : updated()
deactivate DBEventos

note right of CE
    Inscrições com status CONFIRMADA
    devem ter reembolso processado
    pelo Financeiro Service (UC20).
end note

CE -> QNotif : publish({tipo: EVENTO_CANCELADO,\neventoID, motivo, qtdInscritos})
activate QNotif
QNotif --> CE : ack()
deactivate QNotif

CE --> APIGW : EventoCanceladoDTO{eventoID, qtdInscritos, alertaReembolsos}
APIGW --> Tela : 200 OK
deactivate APIGW
Tela --> Org : exibirEventoCancelado(qtdInscritos, mensagemReembolsos)

deactivate CE
deactivate Tela

group Fluxo Assíncrono — Notificação de Cancelamento

    QNotif -> WN : consumir(EVENTO_CANCELADO)
    activate WN
    WN -> SE : notificarParticipantesEventoCancelado(listaEmails, motivo, dadosEvento)
    activate SE
    SE --> WN : emailsDisparados(qtd)
    deactivate SE
    deactivate WN

end

@enduml
