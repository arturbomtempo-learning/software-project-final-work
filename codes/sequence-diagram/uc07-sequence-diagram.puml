@startuml uc07-sequence-diagram

autonumber

title UC07 — Realizar Pagamento do Ingresso

skinparam backgroundColor #FAFFFE

skinparam sequence {
    ArrowColor #1B5E20
    ArrowFontColor #33691E
    LifeLineBorderColor #558B2F
    LifeLineBackgroundColor #F1F8E9
    ParticipantBorderColor #2E7D32
    ParticipantBackgroundColor #E8F5E9
    ParticipantFontStyle bold
    ActorBorderColor #2E7D32
    ActorBackgroundColor #E8F5E9
    GroupBorderColor #558B2F
    GroupHeaderFontColor #1B5E20
    GroupBackgroundColor #F9FBE7
    BoxBorderColor #558B2F
    BoxBackgroundColor #F9FBE7
    DividerBorderColor #2E7D32
    DividerBackgroundColor #C8E6C9
    DividerFontColor #1B5E20
}

skinparam note {
    BackgroundColor #FFFDE7
    BorderColor #F9A825
}

skinparam database {
    BackgroundColor #E8EAF6
    BorderColor #283593
}

skinparam queue {
    BackgroundColor #FFF8E1
    BorderColor #E65100
}

actor "Participante" as Part

participant "Frontend" as Tela
participant "API Gateway" as APIGW
participant "ControleFinanceiro" as CF
participant "ControleInscricao" as CI
participant "Stripe API" as Stripe

database "PostgreSQL\nFinanceiro" as DBFin
database "PostgreSQL\nEventos" as DBEventos

queue "Fila de\nConfirmações" as QConf
queue "Fila de\nNotificações" as QNotif

participant "Worker\nFinanceiro" as WF
participant "Worker\nNotificações" as WN
participant "Serviço de Email" as SE

== Inicialização da Sessão de Pagamento ==

Part -> Tela : iniciarPagamento(inscricaoID)
activate Tela

Tela -> APIGW : obterDadosPagamento(inscricaoID)
activate APIGW

APIGW -> CF : obterSessaoPagamento(inscricaoID, participanteID)
activate CF

CF -> CI : verificarInscricaoPendente(inscricaoID)
activate CI
CI -> DBEventos : findInscricaoById(inscricaoID)
activate DBEventos
DBEventos --> CI : inscricaoEncontrada(status=PENDENTE, valor, eventoID)
deactivate DBEventos
CI --> CF : inscricaoValida(valor, dadosEvento)
deactivate CI

CF -> DBFin : findPagamentoByInscricao(inscricaoID)
activate DBFin
DBFin --> CF : pagamentoEncontrado(pagamentoID, status=PENDENTE, valor)
deactivate DBFin

CF --> APIGW : sessaoPagamentoInicializada(pagamentoID, valor, metodosDisponiveis)
APIGW --> Tela : sessaoPagamentoInicializada(dadosPagamento)
Tela --> Part : exibirOpcoesMetodoPagamento(valor, metodos)

deactivate CF
deactivate APIGW
deactivate Tela

== Confirmação de Ação — UC29 (include) ==

Part -> Tela : selecionarMetodoEConfirmar(metodo, dadosCartao)
activate Tela

note over Part, Tela
    UC29 — Confirmar Ação (include):
    Sistema exibe resumo detalhado do pagamento
    (valor, método, dados do evento e ingresso).
    Participante revisa e confirma explicitamente
    antes do processamento financeiro.
end note

Tela -> APIGW : processarPagamento(pagamentoID, metodo, dadosCartao)
activate APIGW

APIGW -> CF : processarPagamento(pagamentoID, metodo, tokenCartao)
activate CF

CF -> DBFin : atualizarPagamento(pagamentoID, metodo, status=PROCESSANDO)
activate DBFin
DBFin --> CF : pagamentoAtualizado()
deactivate DBFin

== Integração com Gateway de Pagamento Externo ==

CF -> Stripe : criarCobranca(tokenCartao, valor, moeda)
activate Stripe

Stripe --> CF : cobrancaProcessada(chargeID, status)
deactivate Stripe

alt Pagamento aprovado pelo Stripe

    CF -> DBFin : atualizarPagamento(pagamentoID, status=APROVADO, chargeID, dataPagamento)
    activate DBFin
    DBFin --> CF : pagamentoAtualizado()
    deactivate DBFin

    CF -> QConf : publicarConfirmacao(PAGAMENTO_CONFIRMADO, inscricaoID, participanteID)
    activate QConf
    QConf --> CF : mensagemPublicada()
    deactivate QConf

    CF --> APIGW : pagamentoAprovado(pagamentoID, comprovante)
    APIGW --> Tela : pagamentoAprovado(dadosPagamento)
    Tela --> Part : exibirComprovantePagamento(pagamentoID, comprovante)

else Pagamento recusado pelo Stripe

    CF -> DBFin : atualizarPagamento(pagamentoID, status=CANCELADO, motivoRecusa)
    activate DBFin
    DBFin --> CF : pagamentoAtualizado()
    deactivate DBFin

    CF --> APIGW : pagamentoRecusado(motivo)
    APIGW --> Tela : pagamentoRecusado(motivo)
    Tela --> Part : exibirErroPagamento(motivoRecusa)

else Falha temporária na comunicação com Stripe

    CF -> DBFin : atualizarPagamento(pagamentoID, status=PENDENTE, observacao)
    activate DBFin
    DBFin --> CF : pagamentoAtualizado()
    deactivate DBFin

    CF --> APIGW : falhaTemporaria()
    APIGW --> Tela : falhaTemporaria()
    Tela --> Part : exibirMensagem("Falha temporária. Tente novamente em instantes.")

end

deactivate CF
deactivate APIGW
deactivate Tela

== Processamento Assíncrono — Confirmação de Inscrição ==

group Fluxo Assíncrono

    QConf -> WF : consumirMensagem()
    activate WF

    WF -> CI : confirmarInscricao(inscricaoID)
    activate CI

    CI -> DBEventos : atualizarInscricao(inscricaoID, status=CONFIRMADA)
    activate DBEventos
    DBEventos --> CI : inscricaoAtualizada()
    deactivate DBEventos

    CI -> DBEventos : atualizarIngresso(ingressoID, status=VALIDO)
    activate DBEventos
    DBEventos --> CI : ingressoAtualizado()
    deactivate DBEventos

    CI -> QNotif : publicarNotificacao(INGRESSO_CONFIRMADO, participanteID, ingressoID, codigoIngresso)
    activate QNotif
    QNotif --> CI : mensagemPublicada()
    deactivate QNotif

    CI --> WF : inscricaoConfirmada(codigoIngresso)
    deactivate CI
    deactivate WF

end

== Processamento Assíncrono — Envio de Ingresso por Email ==

group Fluxo Assíncrono

    QNotif -> WN : consumirMensagem()
    activate WN
    WN ->> SE : enviarEmailIngressoConfirmado(participanteEmail, codigoIngresso, qrCode, dadosEvento)
    deactivate WN
    activate SE
    SE ->> Part : emailIngressoConfirmado()
    deactivate SE

end

@enduml
