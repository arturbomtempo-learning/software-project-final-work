@startuml general-sequence-diagram

title Diagrama de Sequência Geral — Sistema de Gerenciamento de Eventos

skinparam backgroundColor #FAFFFE

skinparam sequence {
    ArrowColor #1B5E20
    ArrowFontColor #33691E
    LifeLineBorderColor #558B2F
    LifeLineBackgroundColor #F1F8E9
    ParticipantBorderColor #2E7D32
    ParticipantBackgroundColor #E8F5E9
    ParticipantFontStyle bold
    ActorBorderColor #2E7D32
    ActorBackgroundColor #E8F5E9
    GroupBorderColor #558B2F
    GroupHeaderFontColor #1B5E20
    GroupBackgroundColor #F9FBE7
    BoxBorderColor #558B2F
    BoxBackgroundColor #F9FBE7
    DividerBorderColor #2E7D32
    DividerBackgroundColor #C8E6C9
    DividerFontColor #1B5E20
    ReferenceBorderColor #2E7D32
    ReferenceBackgroundColor #C8E6C9
    ReferenceHeaderBackgroundColor #A5D6A7
    ReferenceHeaderFontColor #1B5E20
}

skinparam note {
    BackgroundColor #FFFDE7
    BorderColor #F9A825
}

skinparam database {
    BackgroundColor #E8EAF6
    BorderColor #283593
}

skinparam queue {
    BackgroundColor #FFF8E1
    BorderColor #E65100
}

actor "Usuário" as Usr
actor "Participante" as Part
actor "Organizador" as Org
actor "Administrador" as Admin

participant "Frontend" as Tela
participant "API Gateway" as APIGW
participant "Usuarios\nService" as US
participant "Eventos\nService" as ES
participant "Financeiro\nService" as FS
participant "Comunicacao\nService" as CS

database "PostgreSQL\nUsuários" as DBU
database "PostgreSQL\nEventos" as DBE
database "PostgreSQL\nFinanceiro" as DBF
database "PostgreSQL\nComunicação" as DBC

queue "Fila de\nPagamentos" as QPay
queue "Fila de\nConfirmações" as QConf
queue "Fila de\nNotificações" as QNotif

== Autenticação e Recuperação de Acesso ==

ref over Usr, Tela, APIGW, US : UC01 — Realizar Login

ref over Usr, Tela, APIGW, US : UC02 — Recuperar Senha (extend de UC01)

== Pesquisa e Descoberta ==

ref over Usr, Tela, APIGW, ES : UC03 — Pesquisar Eventos Disponíveis

ref over Usr, Tela, APIGW, ES : UC04 — Pesquisar Locais de Entretenimento

ref over Part, Tela, APIGW, US : UC10 — Visualizar Perfil do Organizador (extend de UC03)

== Gestão de Contas ==

ref over Part, Tela, APIGW, US : UC05 — Gerenciar Conta de Participante

ref over Org, Tela, APIGW, US : UC15 — Gerenciar Conta de Organizador

== Favoritos ==

ref over Part, Tela, APIGW, ES : UC14 — Favoritar Eventos

== Inscrição e Ingressos ==

ref over Part, Tela, APIGW, ES : UC06 — Gerenciar Inscrição no Evento (ver diagrama detalhado)

ref over Part, Tela, APIGW, FS : UC07 — Realizar Pagamento do Ingresso (ver diagrama detalhado, inclui UC29)

ref over Part, Tela, APIGW, ES : UC09 — Visualizar Ingresso

ref over Part, Tela, APIGW, ES : UC13 — Avaliar Evento Participado (inclui UC29)

ref over Part, Tela, APIGW, FS : UC08 — Solicitar Reembolso do Ingresso (inclui UC29)

== Gestão de Eventos (Organizador) ==

ref over Org, Tela, APIGW, ES : UC16 — Gerenciar Eventos (ver diagrama detalhado)

ref over Org, Tela, APIGW, ES : UC17 — Gerenciar Locais de Entretenimento

ref over Org, Tela, APIGW, ES : UC18 — Visualizar Participantes do Evento

ref over Org, Tela, APIGW, ES : UC19 — Visualizar Métricas dos Eventos

ref over Org, Tela, APIGW, ES : UC23 — Visualizar Avaliações dos Eventos

ref over Org, Tela, APIGW, ES : UC24 — Validar Ingresso

== Gestão Financeira (Organizador) ==

ref over Org, Tela, APIGW, FS : UC20 — Gerenciar Solicitações de Reembolso

ref over Org, Tela, APIGW, FS : UC22 — Consultar Comprovantes de Pagamento

== Comunicação (Organizador / Participante) ==

ref over Part, Tela, APIGW, CS : UC11 — Enviar Dúvida para o Organizador do Evento

ref over Org, Tela, APIGW, CS : UC21 — Responder Dúvidas dos Participantes

ref over Part, Tela, APIGW, CS : UC12 — Fornecer Feedback sobre a Plataforma

== Administração ==

ref over Admin, Tela, APIGW, ES : UC25 — Gerenciar Categorias de Eventos

ref over Admin, Tela, APIGW, US : UC26 — Gerenciar Acesso de Organizadores

ref over Admin, Tela, APIGW, ES : UC27 — Moderar Eventos

ref over Admin, Tela, APIGW, CS : UC28 — Visualizar Feedbacks sobre a Plataforma

== Ação Comum de Confirmação ==

note over Part, FS
    UC29 — Confirmar Ação (include)
    Acionado em: UC07 (Realizar Pagamento), UC08 (Solicitar Reembolso), UC13 (Avaliar Evento).
    Sistema exibe resumo completo da operação antes de processar.
    Participante revisa os dados e confirma explicitamente.
end note

== Fluxo Assíncrono de Mensageria — RabbitMQ ==

group Fluxo Assíncrono — Fila de Pagamentos

    QPay -> FS : consumirMensagem()
    activate FS
    FS ->> QConf : publicarResultadoPagamento(inscricaoID, status)
    deactivate FS

end

group Fluxo Assíncrono — Fila de Confirmações

    QConf -> ES : consumirMensagem()
    activate ES
    ES ->> QNotif : publicarNotificacao(participanteID, tipoNotificacao)
    deactivate ES

end

group Fluxo Assíncrono — Fila de Notificações

    QNotif -> CS : consumirMensagem()
    activate CS
    CS ->> Part : enviarEmailTransacional()
    deactivate CS

end

@enduml
