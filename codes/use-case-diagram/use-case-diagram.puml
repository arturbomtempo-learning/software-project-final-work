@startuml
left to right direction

skinparam packageStyle rectangle

actor Usuario as User
actor Participante as Part
actor Organizador as Org
actor Administrador as Admin

User <|-- Part
User <|-- Org
User <|-- Admin

rectangle "Sistema de Gerenciamento de Eventos" {
    usecase "UC01: Realizar login" as UC_Login
    usecase "UC02: Recuperar senha" as UC_ResetPassword
    usecase "UC03: Pesquisar eventos disponíveis" as UC_SearchEvents
    usecase "UC04: Pesquisar locais de entretenimento" as UC_SearchLocations

    usecase "UC05: Gerenciar conta de participante" as UC_ManageParticipant
    usecase "UC06: Gerenciar inscrição no evento" as UC_ManageReservation
    usecase "UC07: Realizar pagamento do ingresso" as UC_MakePayment
    usecase "UC08: Solicitar reembolso do ingresso" as UC_RequestRefund
    usecase "UC09: Visualizar ingresso" as UC_ViewTicket
    usecase "UC10: Visualizar perfil do organizador" as UC_ViewOrganizer
    usecase "UC11: Enviar dúvida para o organizador do evento" as UC_SubmitQuestion
    usecase "UC12: Fornecer feedback sobre a plataforma" as UC_SubmitFeedback
    usecase "UC13: Avaliar evento participado" as UC_RateEvent
    usecase "UC14: Favoritar eventos" as UC_BookmarkEvent

    usecase "UC15: Gerenciar conta de organizador" as UC_ManageOrganizer
    usecase "UC16: Gerenciar eventos" as UC_ManageEvents
    usecase "UC17: Gerenciar locais de entretenimento" as UC_ManageLocation
    usecase "UC18: Visualizar participantes do evento" as UC_ViewParticipants
    usecase "UC19: Visualizar métricas dos eventos" as UC_ViewMetrics
    usecase "UC20: Gerenciar solicitações de reembolso" as UC_ManageRefund
    usecase "UC21: Responder dúvidas enviadas pelos participantes" as UC_AnswerQuestions
    usecase "UC22: Consultar comprovantes de pagamento" as UC_SearchReceipts
    usecase "UC23: Visualizar avaliações dos eventos" as UC_ViewReviews
    usecase "UC24: Validar ingresso" as UC_ValidateTicket

    usecase "UC25: Gerenciar categorias de eventos" as UC_ManageCategories
    usecase "UC26: Gerenciar acesso de organizadores" as UC_ManageAccess
    usecase "UC27: Moderar eventos" as UC_ModerateEvents
    usecase "UC28: Visualizar feedbacks sobre a plataforma" as UC_ViewFeedbacks

    usecase "UC29: Confirmar ação" as UC_ConfirmAction
}

User --> UC_Login
User --> UC_SearchEvents
User --> UC_SearchLocations

Part --> UC_ManageParticipant
Part --> UC_ManageReservation
Part --> UC_MakePayment
Part --> UC_ViewTicket

Part --> UC_RequestRefund
UC_RequestRefund --> Org

Part --> UC_SubmitQuestion
UC_SubmitQuestion --> Org

Part --> UC_SubmitFeedback
UC_SubmitFeedback --> Admin

Part --> UC_RateEvent
UC_RateEvent --> Org

Part --> UC_BookmarkEvent

Org --> UC_ManageOrganizer
Org --> UC_ManageEvents
Org --> UC_ManageLocation
Org --> UC_ViewParticipants
Org --> UC_ViewMetrics

Org --> UC_ManageRefund
UC_ManageRefund --> Part

Org --> UC_AnswerQuestions
UC_AnswerQuestions --> Part

Org --> UC_SearchReceipts
Org --> UC_ViewReviews
Org --> UC_ValidateTicket

Admin --> UC_ManageCategories
Admin --> UC_ManageAccess
Admin --> UC_ModerateEvents
Admin --> UC_ViewFeedbacks

UC_MakePayment ..> UC_ConfirmAction : <<include>>
UC_RequestRefund ..> UC_ConfirmAction : <<include>>
UC_RateEvent ..> UC_ConfirmAction : <<include>>

UC_ResetPassword ..> UC_Login : <<extend>>
UC_ViewOrganizer ..> UC_SearchEvents : <<extend>>

@enduml