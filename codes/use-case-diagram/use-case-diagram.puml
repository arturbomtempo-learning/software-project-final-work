@startuml
left to right direction

skinparam packageStyle rectangle

actor Usuario as User
actor Participante as Part
actor Organizador as Org
actor Administrador as Admin

User <|-- Part
User <|-- Org
User <|-- Admin

rectangle "Sistema de Gerenciamento de Eventos" {
    usecase "UC01: Realizar login" as UC_Login
    usecase "UC02: Recuperar senha" as UC_ResetPassword
    usecase "UC03: Pesquisar eventos disponíveis" as UC_SearchEvents
    usecase "UC04: Pesquisar locais de entretenimento" as UC_SearchLocations

    usecase "UC05: Gerenciar conta de participante" as UC_ManageParticipant
    usecase "UC06: Gerenciar inscrição no evento" as UC_ManageReservation
    usecase "UC07: Realizar pagamento do ingresso" as UC_MakePayment
    usecase "UC08: Solicitar reembolso do ingresso" as UC_RequestRefund
    usecase "UC09: Visualizar ingresso" as UC_ViewTicket
    usecase "UC10: Enviar dúvida para o organizador do evento" as UC_SubmitQuestion
    usecase "UC11: Fornecer feedback sobre a plataforma" as UC_SubmitFeedback
    usecase "UC12: Avaliar evento participado" as UC_RateEvent
    usecase "UC13: Favoritar eventos" as UC_BookmarkEvent

    usecase "UC14: Gerenciar conta de organizador" as UC_ManageOrganizer
    usecase "UC15: Gerenciar eventos" as UC_ManageEvents
    usecase "UC16: Gerenciar locais de entretenimento" as UC_ManageLocation
    usecase "UC17: Visualizar participantes do evento" as UC_ViewParticipants
    usecase "UC18: Visualizar métricas dos eventos" as UC_ViewMetrics
    usecase "UC19: Gerenciar solicitações de reembolso" as UC_ManageRefund
    usecase "UC20: Responder dúvidas enviadas pelos participantes" as UC_AnswerQuestions
    usecase "UC21: Consultar comprovantes de pagamento" as UC_SearchReceipts
    usecase "UC22: Visualizar avaliações dos eventos" as UC_ViewReviews
    usecase "UC23: Validar ingresso" as UC_ValidateTicket

    usecase "UC24: Gerenciar categorias de eventos" as UC_ManageCategories
    usecase "UC25: Gerenciar acesso de organizadores" as UC_ManageAccess
    usecase "UC26: Moderar eventos" as UC_ModerateEvents
    usecase "UC27: Visualizar feedbacks sobre a plataforma" as UC_ViewFeedbacks

    usecase "UC28: Confirmar ação" as UC_ConfirmAction
}

User --> UC_Login
User --> UC_SearchEvents
User --> UC_SearchLocations

Part --> UC_ManageParticipant
Part --> UC_ManageReservation
Part --> UC_MakePayment
Part --> UC_ViewTicket

Part --> UC_RequestRefund
UC_RequestRefund --> Org

Part --> UC_SubmitQuestion
UC_SubmitQuestion --> Org

Part --> UC_SubmitFeedback
UC_SubmitFeedback --> Admin

Part --> UC_RateEvent
UC_RateEvent --> Org

Part --> UC_BookmarkEvent

Org --> UC_ManageOrganizer
Org --> UC_ManageEvents
Org --> UC_ManageLocation
Org --> UC_ViewParticipants
Org --> UC_ViewMetrics

Org --> UC_ManageRefund
UC_ManageRefund --> Part

Org --> UC_AnswerQuestions
UC_AnswerQuestions --> Part

Org --> UC_SearchReceipts
Org --> UC_ViewReviews
Org --> UC_ValidateTicket

Admin --> UC_ManageCategories
Admin --> UC_ManageAccess
Admin --> UC_ModerateEvents
Admin --> UC_ViewFeedbacks

UC_MakePayment ..> UC_ConfirmAction : <<include>>
UC_RequestRefund ..> UC_ConfirmAction : <<include>>
UC_RateEvent ..> UC_ConfirmAction : <<include>>

UC_ResetPassword ..> UC_Login : <<extend>>

@enduml