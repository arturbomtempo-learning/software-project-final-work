@startuml implantation-diagram

skinparam shadowing false
skinparam backgroundColor white
skinparam defaultFontSize 11
skinparam nodeStyle default

top to bottom direction

title Diagrama de Implantação - Sistema de Gerenciamento de Eventos

'==========================
' DISPOSITIVO CLIENTE
'==========================

node "Dispositivo Cliente" <<device>> as ClientDevice {
    node "Navegador Web" as Browser
}

'==========================
' VERCEL — SERVIDOR FRONTEND
'==========================

node "Vercel" <<server>> as VercelServer {
    node "CDN Global" as CDN {
        artifact "Next.js Application\n(SSR + Static Assets)" as NextApp
    }
}

'==========================
' AWS — INFRAESTRUTURA DE ENTRADA
'==========================

node "AWS API Gateway" <<service>> as APIGWNode {
    artifact "Amazon API Gateway" as APIGateway
}

node "AWS Application Load Balancer" <<service>> as ALBNode {
    artifact "Application Load Balancer" as ALBArtifact
}

'==========================
' AWS ECS — CONTÊINERES DE MICROSSERVIÇOS
'==========================

node "AWS ECS Cluster" <<executionEnvironment>> as ECSCluster {

    node "Contêiner — Usuários" <<container>> as ContainerUsers {
        artifact "Serviço Usuários\n(Spring Boot JAR)" as UserJar
    }

    node "Contêiner — Eventos" <<container>> as ContainerEvents {
        artifact "Serviço Eventos\n(Spring Boot JAR)" as EventJar
    }

    node "Contêiner — Financeiro" <<container>> as ContainerFinancial {
        artifact "Serviço Financeiro\n(Spring Boot JAR)" as FinancialJar
    }

    node "Contêiner — Comunicação" <<container>> as ContainerComm {
        artifact "Serviço Comunicação\n(Spring Boot JAR)" as CommJar
    }

}

'==========================
' AWS RDS — BANCOS DE DADOS
'==========================

node "AWS RDS" <<server>> as RDSNode {
    database "PostgreSQL — Usuários"    as DBUsers
    database "PostgreSQL — Eventos"     as DBEvents
    database "PostgreSQL — Financeiro"  as DBFinancial
    database "PostgreSQL — Comunicação" as DBComm
}

'==========================
' AWS EC2 — MENSAGERIA
'==========================

node "AWS EC2 — Mensageria" <<server>> as EC2Node {
    node "Docker — RabbitMQ" <<container>> as DockerRabbitMQ {
        artifact "RabbitMQ Broker" as RabbitMQ
    }
}

'==========================
' STRIPE — SERVIÇO EXTERNO
'==========================

node "Stripe" <<external>> as StripeNode {
    artifact "Stripe API" as StripeAPI
}

'==========================
' AWS CLOUDWATCH — MONITORAMENTO
'==========================

node "AWS CloudWatch" <<service>> as CloudWatchNode {
    artifact "Logs e Monitoramento" as CloudWatch
}

'==========================
' FLUXO PRINCIPAL DE REQUISIÇÕES
'==========================

ClientDevice --> VercelServer : <<HTTPS>>
VercelServer --> APIGWNode   : <<HTTPS>>
APIGWNode    --> ALBNode      : <<HTTPS>>

ALBNode --> ContainerUsers    : <<HTTP>>
ALBNode --> ContainerEvents   : <<HTTP>>
ALBNode --> ContainerFinancial : <<HTTP>>
ALBNode --> ContainerComm     : <<HTTP>>

'==========================
' MICROSSERVIÇOS → BANCOS DE DADOS
'==========================

ContainerUsers    --> DBUsers    : <<TCP/IP>>
ContainerEvents   --> DBEvents   : <<TCP/IP>>
ContainerFinancial --> DBFinancial : <<TCP/IP>>
ContainerComm     --> DBComm     : <<TCP/IP>>

'==========================
' MICROSSERVIÇOS → MENSAGERIA
'==========================

ContainerEvents    --> EC2Node : <<AMQP>>
ContainerFinancial --> EC2Node : <<AMQP>>
ContainerComm      --> EC2Node : <<AMQP>>

'==========================
' COMUNICAÇÃO ENTRE MICROSSERVIÇOS
'==========================

ContainerEvents    --> ContainerUsers    : <<REST/HTTP>>
ContainerFinancial --> ContainerUsers    : <<REST/HTTP>>
ContainerFinancial --> ContainerEvents   : <<REST/HTTP>>
ContainerComm      --> ContainerUsers    : <<REST/HTTP>>
ContainerComm      --> ContainerEvents   : <<REST/HTTP>>

'==========================
' FINANCEIRO → STRIPE
'==========================

ContainerFinancial --> StripeNode : <<HTTPS>>

'==========================
' MICROSSERVIÇOS → MONITORAMENTO
'==========================

ContainerUsers     ..> CloudWatchNode : <<logs>>
ContainerEvents    ..> CloudWatchNode : <<logs>>
ContainerFinancial ..> CloudWatchNode : <<logs>>
ContainerComm      ..> CloudWatchNode : <<logs>>

@enduml
